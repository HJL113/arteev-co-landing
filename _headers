# Cloudflare Pages response headers. HSTS + HTTP→HTTPS redirect are set at the
# Cloudflare zone level (SSL/TLS → Edge Certificates), not here.
# CSP intentionally omitted — needs testing against the page's inline styles + Google Fonts first.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
